# Copy to .env (gitignored). sqlx reads DATABASE_URL at test time, and
# of-server loads this file at startup — dotenvy never overrides a variable
# that is already set, so a real deployment's environment always wins.

DATABASE_URL=postgres://factory:factory@localhost:15433/otto_factory

# ---------------------------------------------------------------- required
# None of these has a default, because a wrong value fails silently.

# Public base URL of this service. The discovery pointer in a 401
# (WWW-Authenticate resource_metadata) and the tracker OAuth callbacks are built
# from it. Get it wrong and nothing crashes: links go to an origin that does not
# exist, and the first report arrives hours later from somebody who cannot connect.
OF_PUBLIC_URL=http://localhost:8080

# The Savvagent platform: the OAuth authorization server, identity directory
# (members, teams), and billing system of record. Savvagent Tower holds no accounts
# of its own. Advertised to MCP clients as this resource's authorization server,
# and called to validate every bearer token (cached 60 s), look up members and
# teams, read usage, and ship metered calls.
OF_PLATFORM_URL=http://localhost:8090

# The credential the platform issued when this service was registered
# (`otto-platform-server resource register <OF_RESOURCE_URI> --name "Savvagent Tower"
# --scopes jobs:read,jobs:write,repos:read,repos:write,messages,trackers,org:admin`).
# Printed once; `resource rotate-secret` issues a new one. Authenticates every call
# to the platform as HTTP Basic with OF_RESOURCE_URI as the user.
OF_INTROSPECTION_SECRET=

# The key the platform signs its lifecycle webhooks with (org.deleted,
# team.deleted, member.removed -> POST /platform/webhooks). Printed once by
# `otto-platform-server resource set-webhook <OF_RESOURCE_URI> <PUBLIC_URL>/platform/webhooks`.
# A different secret from the one above, on purpose.
OF_PLATFORM_WEBHOOK_SECRET=

# 32 bytes, base64. Encrypts tracker credentials and webhook secrets at rest.
# Generate: openssl rand -base64 32
# There is no default and no generate-on-startup: a key that changes across a
# restart makes every stored tracker credential unreadable.
OF_ENCRYPTION_KEY=

# ---------------------------------------------------------------- optional
# Defaults shown. A variable that is set but unparseable is a startup error,
# never a silent fallback to the default.

OF_BIND=0.0.0.0:8080

# Canonical public URI of the MCP resource. Tokens are audience-bound to this
# (RFC 8707); the platform answers "inactive" for a token minted for any other
# resource. It must be EXACTLY the resource_uri registered at the platform.
# Defaults to $OF_PUBLIC_URL/mcp, which is where this binary serves it.
#OF_RESOURCE_URI=http://localhost:8080/mcp

# GitHub App id for tracker integration. Leave unset when this deployment does
# not offer GitHub issue sync.
#OF_GITHUB_APP_ID=

# PEM-encoded GitHub App private key. Used later to mint installation tokens
# for the configured App; leaving it unset cleanly disables GitHub integration.
# If your secret store only accepts a single-line value, replace each real
# newline in the PEM with a literal `\n` — it is normalized back to a real
# newline on load.
#OF_GITHUB_APP_PRIVATE_KEY=

# Shared secret GitHub signs webhook deliveries with. Task 3 verifies
# X-Hub-Signature-256 against it; leave it unset when GitHub integration is off.
#OF_GITHUB_APP_WEBHOOK_SECRET=

# The GitHub App's URL slug — the name in github.com/apps/<slug>. The console
# builds the "install this App" link from it, so with it unset there is no
# Connect GitHub button rather than a link that 404s.
#OF_GITHUB_APP_SLUG=

# The GitHub App's *user*-to-server OAuth credentials, which are not the same
# thing as OF_GITHUB_APP_PRIVATE_KEY above (that one is server-to-server). The
# console exchanges them for a user token to check that the admin binding an
# installation id actually administers that installation. Without that check,
# any org admin could type any unclaimed installation id and drive another
# customer's GitHub issues, so with these unset the connect flow is not offered.
#
# The App itself must have "Request user authorization (OAuth) during
# installation" enabled, or GitHub's post-install redirect carries no code and
# there is nothing to verify. Nothing here can detect that setting in advance.
#OF_GITHUB_APP_CLIENT_ID=
#OF_GITHUB_APP_CLIENT_SECRET=

# Atlassian OAuth client id and secret for JIRA tracker sync. Leave them unset
# when this deployment does not offer JIRA issue sync.
#OF_JIRA_CLIENT_ID=
#OF_JIRA_CLIENT_SECRET=

# The console's OAuth client id at the platform, for signing in to the console. A
# public first-party client the platform's operator registers:
#   otto-platform-server client register --name "Savvagent Tower console" \
#     --redirect-uri $OF_PUBLIC_URL/auth/callback --first-party
# Unset, the server runs and /auth/login answers 503 console_login_disabled.
# For `npm run dev` in web/, set OF_PUBLIC_URL=http://localhost:5173 and register
# http://localhost:5173/auth/callback too: the browser has to come back to the
# origin its session cookie lives on.
#OF_CONSOLE_CLIENT_ID=

# The built console bundle, served with an index.html fallback. Run
# `npm run build` in web/ to produce it.
#OF_STATIC_DIR=web/build

# Extra authorities accepted in the MCP endpoint's Host header, comma
# separated. $OF_PUBLIC_URL's host is always accepted; add others when the
# deployment answers to more than one name. An entry with no port matches any
# port.
#
# Required when anything proxies to this server under a different name — a
# Cloudflare Worker cannot set the Host header on a subrequest, so the origin
# sees its own hostname and refuses every authenticated MCP call while
# unauthenticated ones still answer a correct 401. Name the origin's hostname
# here. docs/deploy/cloudflare.md
#OF_ALLOWED_HOSTS=

# Deprecated public hostnames this deployment still answers on, comma
# separated, bare hostnames only (no scheme, port, path, empty entry or
# trailing dot). Set after a rename,
# for the old host, until its sunset; unset otherwise, and then nothing changes.
#
# Why: clients configured with the old URL must keep working, and must be told
# to move. A request whose origin host (X-Forwarded-Host, else Host) is one of
# these is accepted like OF_ALLOWED_HOSTS, and every response to it carries
# `Deprecation: true` and `Link: <$OF_PUBLIC_URL/...>; rel="successor-version"`;
# MCP `initialize` instructions open with a deprecation paragraph; and discovery
# (/.well-known/oauth-protected-resource and the 401's resource_metadata) names
# the legacy host with OF_RESOURCE_URI's path (https://<legacy host>/mcp) so a
# fresh sign-in on the old URL passes the
# client's RFC 9728 resource check. The host only selects among these values:
# tokens are still validated against OF_RESOURCE_URI alone. A value that is set
# but not a list of bare hostnames, or that names OF_PUBLIC_URL's own host,
# stops the server at startup. docs/deploy/fly.md (the rename cutover)
#OF_LEGACY_HOSTS=otto-factory.savvagent.com

# When the legacy hosts stop working: an RFC 3339 date-time
# (2027-01-31T00:00:00Z) or date (2027-01-31, midnight UTC). Optional, but set
# it: it is announced in a `Sunset` header on every legacy-host response and in
# the MCP instructions, and without it callers are told only "eventually". Set
# but unparseable, or set without OF_LEGACY_HOSTS, stops the server at startup.
# Once the date has passed the old host still answers (until you remove it),
# its notice says it was retired, and every startup logs a warning.
#OF_LEGACY_SUNSET=2027-01-31T00:00:00Z

# Browser origins accepted on /mcp requests that carry Origin. Empty disables
# the check, which is right for a surface reached by CLI agents.
#OF_ALLOWED_ORIGINS=

# Apply migrations at startup. On by default; sqlx holds a Postgres advisory
# lock for the run, so several replicas starting together is safe.
#OF_RUN_MIGRATIONS=1

# json for a log aggregator, text for a terminal.
#OF_LOG_FORMAT=text

# OF_ENFORCE_QUOTAS is retired and has no effect (the server warns if it is
# set): a completed job is always refused when the platform reports the org
# blocked (budget_exceeded or payment_required), and nothing else is refused.

# Where an owner is sent to raise the budget or add a card when a completed job
# is refused. Defaults to $OF_PLATFORM_URL, the otto console's home, which lists
# the user's orgs; billing lives under each org there.
#OF_UPGRADE_URL=

# Per-crate levels for local work. Nothing here logs a credential: request spans
# carry no headers, so a bearer token never reaches a log.
RUST_LOG=info,of_server=debug,of_mcp=debug,of_web=debug
