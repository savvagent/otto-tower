{
  // The console, deployed to Cloudflare as one Worker that serves the built SPA
  // and forwards everything dynamic to tower-server. See docs/deploy/cloudflare.md
  // for the account-side setup this file cannot express, and worker/index.ts for
  // why it is a proxy rather than a second origin.
  "$schema": "node_modules/wrangler/config-schema.json",
  // The default config is the development one, and it is named as such: a
  // bare `wrangler deploy` should never be able to land on the Worker the
  // console actually runs on. Production is a named environment below.
  "name": "otto-factory-console-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-02",

  "assets": {
    // `npm run build` output. adapter-static writes hashed filenames under
    // _app/immutable, so the bundle is safe to cache hard and the HTML is not.
    "directory": "./build",
    "binding": "ASSETS",
    // Client-side routing: an unknown path is a route the SPA renders, not a
    // 404. The server's ServeDir fallback does the same thing for self-hosters.
    "not_found_handling": "single-page-application",

    // Every request enters the Worker, including asset requests.
    //
    // The alternative is a glob list — ["/api/*", "/oauth/*", …] — which is
    // cheaper, because assets would be served without an invocation. It is also
    // a second, differently-shaped copy of a rule that already exists twice
    // (here and in tower-server), expressed in a pattern language whose treatment
    // of `/` inside `*` decides whether `/api/orgs/nope` reaches the origin at
    // all. When that glob is wrong the failure is silent and specific: the asset
    // router answers with index.html and a 200, and an agent retries forever
    // against a route that will never exist.
    //
    // One rule, in TypeScript, matching the server's — for a console behind a
    // login, whose whole audience is the people already signed in, the
    // invocations that buys are worth the certainty.
    "run_worker_first": true
  },

  "vars": {
    // Where tower-server listens. Not a secret — a hostname.
    //
    // The default is the local origin on purpose. A deploy that forgets to name
    // an environment then proxies to somewhere that is not listening and fails
    // loudly, which is the failure everyone wants; the same slot holding a
    // production hostname would mean a staging Worker silently serving real
    // user traffic from production, and nothing about it would look wrong.
    "OF_ORIGIN": "http://127.0.0.1:8080"
  },

  // Production is named, never inherited: `wrangler deploy --env production`.
  //
  // `name` is stated here because wrangler otherwise derives it by suffixing the
  // top-level one, and a deploy that silently created `otto-factory-console-dev-production`
  // would look successful while serving nobody.
  "env": {
    "production": {
      "name": "otto-factory-console",
      // The rename cutover (docs/deploy/fly.md, step 8) adds OF_PUBLIC_URL and
      // OF_LEGACY_HOSTS here, with the same values as tower-server's, so the old
      // host's console pages and /auth/login 308 to the new host. They are
      // absent until then on purpose: set early, they would redirect browsers
      // to a host that is not serving yet.
      "vars": {
        "OF_ORIGIN": "https://otto-factory-mcp.fly.dev"
      }
    }
  },

  "observability": {
    "enabled": true
  }
}
